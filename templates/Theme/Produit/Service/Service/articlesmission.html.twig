{% extends "Theme/Users/User/layouthome.html.twig" %}
{% block meta %}
  {{ parent() }}
  <meta name="keywords" content="{{ site }}, start-up, applications,référencement,annuaire, annonces,technologie, hébergement web,e-commerce,stratégie marketing,annonces, annonce afrique,études, bonnes affaires, hébergement web illimité,hébergement, site internet, site, gratuite,hébergement revendeur,template,domaine, nom de domaine, visite guidée, cameroun, site cameroun,hébergement web cameroun,site moins cher, vente en ligne, commerce en afrique, afrique Explorer, web marketing, référencement SEO, développement web sur mesure, {{ keywords }}"/>
  <meta name="author" content="Noel Kenfack"/>
  <meta name="description" content="AFHunt est une entreprise Camerounaise qui vise à opérer une véritable transformation numérique au Cameroun et en Afrique, pour faciliter les opérations digitales des particuliers et des entreprises. "/>
{% endblock %}

{% block title %}
  {{ parent() }} - Solutions et services intelligents prêt à l'emplois
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
{% endblock %}

{% block userblog_body %}

<div style="position: absolute; z-index: 1; top: 0px; width: 100%;">
  <img src="{{ asset('afhholding/images/vector-top.png') }}" alt="" style="height: 500px;"/>
</div>

<div class="container">

<div class="shadow- bg-light1"style="padding: 0px 0px 15px 0px; z-index: 1; position: relative!important; background: #fff;  box-shadow: 0px 1px 5px 0px #d4d8de;">
  <!-- div style="height: 40px; background: #fff;"></div -->
  <div class="container" style="padding-top: 5px;">
    <h3>Notre mission en quelques points
      <span style="float: right;">
        <a href="#!">
          <span class="fa fa-heart"></span>
        </a>
      </span>
    </h3>
  </div>
</div>

<section  style="padding-top: 20px; margin: 0 auto;">

<div class="row">

<div class="col-md-12">
<div class="animecourant-panel-popup" style="display: block;">
    
</div>
</div>

<div class="col-sm-12 col-md-8">

    <div class="shadow3" style="border: 3px solid #9dba3d; border-radius: 5px;">
      <div class="article-detail article-panel">
        <!-- h2>Le Challenge est grand</h2 -->
        <h4 style="margin-bottom: 20px;">
          Dans un monde où les inégalités ne cessent de croître, les pays dominés doivent s’éveiller pour déjouer les stratégies de domination qui les maintiennent dans une position d’infériorité. Leur émancipation est essentielle pour bâtir un avenir plus équilibré et prospère.

          Chez <span class="mic" style="background: #98d3ce; color: #fff;">AFHunt Think Tank</span>, nous nous engageons à analyser les défis auxquels ces nations sont confrontées, afin de proposer des solutions innovantes et d’agir concrètement pour contribuer à les positionner comme des acteurs majeurs du monde multipolaire. Notre mission reflète notre détermination à bâtir des sociétés autonomes, influentes et porteuses de progrès, tant sur notre planète actuelle qu’au-delà.
        </h4>
      </div>
    </div>

  <div class="card-flex">
    <!--  Main Content -->
    <div class="row">
      {% for article in liste_article %}
      <div class="col-sm-12 col-md-6">
          <div class="item">
            <div class="blog-post">
              <a href="{{ path('produit_service_commentaire_article', {'id': article.id }) }}" class="blog-img banner-hover">
                <img class="img-fluid" src="{% if article.imgservice != null %}{{ asset(article.imgservice.getwebpath) }}{% else %}{{ asset('template/images/bglogin.png') }}{% endif %}" alt="" style="height: 300px;">
                <span class="blog-icon"><i class="fa fa-link" aria-hidden="true"></i></span>
                <span class="date-time">
                  <span class="date">{{ article.date|date('d') }}</span>,
                  <span class="time">{{ article.date|date('M') }}</span>,
                  <span class="year">{{ article.date|date('Y') }}</span>
                </span>
              </a>
              <div class="blog-post-content">
                <a href="{{ path('produit_service_commentaire_article', {'id': article.id }) }}" class="blog-title" title="{{ article.nom }}">{{ article.nom }}</a>
                <p class="blog-desc">{{ article.breve }}</p>
                <a href="{{ path('produit_service_commentaire_article', {'id': article.id }) }}" class="btn btn-style2">Consulter <span class="fa fa-check-circle"></span></a>
              </div>
            </div>
          </div>
       </div>
       {% endfor %}

    </div>
    <!-- End:begins  -->
  </div>

  <div class="clearfix"></div>
	{% if nombrepage > 0 %}
				
	{% if page > 1 and page <= nombrepage %}
	{% set pagepre = page - 1 %}
	{% else %}
		{% set pagepre = nombrepage %}
	{% endif %}

	{% if page < nombrepage %}
		{% set pagesuiv = page + 1 %}
	{% else %}
		{% set pagesuiv =  1 %}
	{% endif %}

	{% if nombrepage < 5 %}
		{% set debut = 1 %}
		{% set fin = nombrepage %}
	{% else %}
		{% if page > 2 and page < (nombrepage - 2) %}
			{% set debut = page - 2 %}
			{% if page + 2 >= nombrepage %}
				{% set fin = nombrepage %}
			{% else %}
				{% set fin = page + 2 %}
			{% endif %}
		{% else %}
			{% if page <= 2 %}
				{% if page == 1 %}
					{% set debut = 1 %}
					{% set fin = page + 3 %}
				{% else %}
					{% set debut = 1 %}
					{% set fin = page + 2 %}
				{% endif %}
			{% else %}
				{% set debut = page - 2 %}
				{% if page + 2 >= nombrepage %}
					{% set fin = nombrepage %}
				{% else %}
					{% set fin = page + 2 %}
				{% endif %}
			{% endif %}
		{% endif %}
		
	{% endif %}

	<div class="row" style="margin: 15px  0px;">
		<div class="col-md-12">
		<div class="flex-container" style="background: #fafafa; ">
			<div class="paginate-ctn">
			<a href="{{ path('produit_service_articles_support', {'position': position, 'page': 1 }) }}" style="display: inline-block;" class="round-effect"> <span class="fa fa-fast-backward"></span> </a>
			<a href="{{ path('produit_service_articles_support', {'position': position, 'page': pagepre }) }}" style="display: inline-block;" class="round-effect"> <span class="fa fa-step-backward"></span> </a>
			{% for p in debut..fin %}
				<a href="{{ path('produit_service_articles_support', {'position': position, 'page': p }) }}" style="display: inline-block;" class="round-effect {% if p == page %}activepage{% endif %}">{{ p }}</a>
			{% endfor %}
			<a href="{{ path('produit_service_articles_support', {'position': position, 'page': pagesuiv }) }}" style="display: inline-block;" class="round-effect"> <span class="fa fa-step-forward"></span> </a>
			<a href="{{ path('produit_service_articles_support', {'position': position, 'page': nombrepage }) }}" style="display: inline-block;" class="round-effect"> <span class="fa fa-fast-forward"></span> </a>
			</div>
		</div>
	</div>
	</div>
	<div class="clearfix"></div>
	{% else %}

	<div class="row" style="margin: 15px  0px;">
		<div class="col-md-12">
		<div class="flex-container" style="background: #fafafa; ">
			<div class="paginate-ctn">
		
			<a href="{{ path('produit_service_articles_support', {'position': position, 'page': page }) }}" style="display: inline-block;" class="round-effect"> <span class="fa fa-fast-backward"></span> </a>
			<a href="{{ path('produit_service_articles_support', {'position': position, 'page': page }) }}" style="display: inline-block;" class="round-effect"> <span class="fa fa-step-backward"></span> </a>
				<a href="{{ path('produit_service_articles_support', {'position': position, 'page': 1 }) }}" style="display: inline-block;" class="round-effect activepage">1</a>
			<a href="{{ path('produit_service_articles_support', {'position': position, 'page': page }) }}" style="display: inline-block;" class="round-effect"> <span class="fa fa-step-forward"></span> </a>
			<a href="{{ path('produit_service_articles_support', {'position': position, 'page': page }) }}" style="display: inline-block;" class="round-effect"> <span class="fa fa-fast-forward"></span> </a>

		</div>
		</div>
	</div>
	</div>

	<div class="clearfix"></div>
	{% endif %}

</div>
<div class="col-sm-12 col-md-4">

{{ render(controller("App\\Controller\\Produit\\Service\\ServiceController:menustruct")) }}
  
</div>
</div>

</section>


</div>

<script type="text/javascript">
var bougepop = 1;
var dimensionpop = 200;
function activateelementPop()
{
var visibility = visibleElement('.animecourant-panel-popup');

if(visibility && bougepop == 0){
    bougepop = 1;
    $('.toutleblock-popup').css('position','relative');
    $('.toutleblock-popup').css('bottom','0px');
    $('.toutleblock-popup').css('margin-bottom','0px');
}
}

function stopelementPop()
{
var visibility = visibleElement('.stop-courant-panel-popup');

if(visibility && bougepop == 1){
    if(visibleElement('.animecourant-panel-popup') && visibleElement('.stop-courant-panel-popup'))
    {
    }else{
    bougepop = 0;
    $('.toutleblock-popup').css('position','fixed');
    $('.toutleblock-popup').css('width',dimensionpop+'px');
    $('.toutleblock-popup').css('bottom','30px');
    $('.toutleblock-popup').css('margin-bottom','0px');
    }
}
}

function controlScrollPop()
{
    var largeur = ($(window).width());
    dimensionpop = $('.toutleblock-popup').width();
    if (largeur >= 768)
    {
        if(visibleElement('.animecourant-panel-popup') && visibleElement('.stop-courant-panel-popup'))
        {
        $('.toutleblock-popup').css('position','fixed');
        $('.toutleblock-popup').css('width',dimensionpop+'px');
        }else{
        window.setInterval(function() { stopelementPop(); }, 100);
        window.setInterval(function() { activateelementPop(); }, 100);
        }
        
    }
}
controlScrollPop();
</script>


{% endblock %}

{% block javascripttemplate %}

    
{% endblock %}
