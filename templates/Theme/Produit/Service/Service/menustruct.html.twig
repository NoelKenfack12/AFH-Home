<style>
	.icon-circle-panel{
		position: absolute; top: 0px; right: 0px; height: 50px; width: 50px; background: #9dba3d; border-radius: 0px 0px 0px 50%; padding: 15px;
	}
	
	.tags {
		width: 100%;
		border-radius: 10px;
		background-color: #fff;
		padding: 10px 0px;
		display: -webkit-box;
		display: -ms-flexbox;
		display: flex;
		-webkit-box-orient: vertical;
		-webkit-box-direction: normal;
		-ms-flex-direction: column;
		flex-direction: column;
	}

	.tags h1 {
		font-size: 20px;
		font-weight: bold;
		margin-bottom: 10px;
		text-transform: capitalize!important;
	}

	.tags ul {
		list-style: none;
		display: -webkit-box;
		display: -ms-flexbox;
		display: flex;
		-ms-flex-wrap: wrap;
		flex-wrap: wrap;
	}

	.tags ul li {
		border-radius: 5px;
		border: 1px solid #1a1b38;
	}

	.tags ul li:first-child {
		margin-right: 10px;
		margin-top: 10px;
	}

	.tags ul li + li {
		margin-right: 10px;
		margin-top: 10px;
	}

	.tags ul li a {
		display: block;
		text-decoration: none;
		padding: 10px 15px;
		font-weight: bold;
		color: black;
	}

	.tags ul li a:hover {
		background-color: #f9eae3;
		-webkit-transition-duration: 350ms;
		transition-duration: 350ms;
	}

	.authors {
		display: -webkit-box;
		display: -ms-flexbox;
		display: flex;
		margin-top: 10px;
		background-color: #fff;
		max-width: 500px;
		width: 100%;
		border-radius: 10px;
		padding: 30px 40px;
		display: flex;
		-webkit-box-orient: vertical;
		-webkit-box-direction: normal;
		-ms-flex-direction: column;
		flex-direction: column;
	}

	.authors h1 {
		font-size: 20px;
		margin-bottom: 10px;
		text-transform: capitalize!important;
	}

	.authors li {
		display: -webkit-box;
		display: -ms-flexbox;
		display: flex;
		-webkit-box-align: center;
		-ms-flex-align: center;
		align-items: center;
	}

	.authors li + li {
		margin-top: 30px;
	}

	.authors li .author_pic {
		display: -webkit-box;
		display: -ms-flexbox;
		display: flex;
	}

	.authors li .author_pic img {
		border-radius: 50%;
		width: 83px;
		height: 83px;
		-o-object-fit: cover;
		object-fit: cover;
	}

	.authors li .author_content {
		display: -webkit-box;
		display: -ms-flexbox;
		display: flex;
		-webkit-box-orient: vertical;
		-webkit-box-direction: normal;
		-ms-flex-direction: column;
		flex-direction: column;
		margin-left: 15px;
	}

	.authors li .author_content h2 {
		font-size: 18px;
		margin-bottom: 5px;
	}

	.authors li .author_content .adress {
		display: -webkit-box;
		display: -ms-flexbox;
		display: flex;
		-webkit-box-orient: horizontal;
		-webkit-box-direction: normal;
		-ms-flex-direction: row;
		flex-direction: row;
		-webkit-box-align: center;
		-ms-flex-align: center;
		align-items: center;
	}

	.authors li .author_content .adress_icon {
		display: -webkit-box;
		display: -ms-flexbox;
		display: flex;
	}

	.authors li .author_content .adress span {
		margin-left: 5px;
	}

	.authors li .follow {
		margin-left: auto;
	}

	.authors li .follow a {
		display: block;
		padding: 10px 15px;
		font-weight: bold;
		color: black;
		border-radius: 5px;
		background-color: #ffc295;
		text-decoration: none;
	}
</style>

