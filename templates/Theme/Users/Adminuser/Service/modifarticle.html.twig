<script type="text/javascript" src="{{ asset('template/js/tiny.min.js') }}"></script>
<script type="text/javascript">
tinymce.init({ selector:'#service_description', entity_encoding: "raw" });
tinymce.init({ selector:'#service_prerequis', entity_encoding: "raw" });

$('#typearticle').change(function(){
	$('.type_produit').hide();
	if($(this).val() == 'about')
	{
		$('.type_about').show();
	}else if($(this).val() == 'mission')
	{
		$('.type_mission').show();
	}else if($(this).val() == 'vision')
	{
		$('.type_vision').show();
	}else if($(this).val() == 'engagement')
	{
		$('.type_engagement').show();
	}else if($(this).val() == 'justice')
	{
		$('.type_justice').show();
	}else if($(this).val() == 'marketing')
	{
		$('.type_marketing').show();
	}else if($(this).val() == 'educationlarge')
	{
		$('.type_educationlarge').show();
	}else if($(this).val() == 'entrepreneur')
	{
		$('.type_entrepreneur').show();
	}else if($(this).val() == 'nosreperes')
	{
		$('.type_nosreperes').show();
	}else if($(this).val() == 'bourse')
	{
		$('.type_bourse').show();
	}else if($(this).val() == 'comptabilite')
	{
		$('.type_comptabilite').show();
	}else if($(this).val() == 'investissment')
	{
		$('.type_investissment').show();
	}else if($(this).val() == 'action')
	{
		$('.type_action').show();
	}else if($(this).val() == 'donation')
	{
		$('.type_donation').show();
	}else if($(this).val() == 'projets')
	{
		$('.type_projets').show();
	}else if($(this).val() == 'cgu')
	{
		$('.type_cgu').show();
	}else if($(this).val() == 'confidentialite')
	{
		$('.type_confidentialite').show();
	}
});
</script>
