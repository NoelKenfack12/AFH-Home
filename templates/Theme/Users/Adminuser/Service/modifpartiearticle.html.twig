
<div class="row">
<div class="col-md-12">
	{{ form_start(formeven, {'attr': {'action': path('users_adminuser_update_partie_current_article', {'id': partie.id}) }}) }}
	   <div class="row">
		  <div class="col-md-12">
		  <span style="color:red;">{{ form_errors(formeven) }}</span>
			<span style="color:red;">{{ form_errors(formeven.nom) }}</span>
			{{ form_widget(formeven.nom) }}
			{{ form_label(formeven.nom,'Nom de l\'article') }}
		  </div>
		  <div class="col-md-12 mb-3">
			{{ form_errors(formeven.rang) }}
			{{ form_widget(formeven.rang) }}
		  </div>
		  <div class="col-md-12 mb-3">
			{{ form_errors(formeven.description) }}
			{{ form_widget(formeven.description, {'attr': {'class': 'materialize-textarea'}}) }}
		  </div>
		  <div class="col-md-12">
			{{ form_errors(formeven.breve) }}
			{{ form_widget(formeven.breve) }}
			{{ form_label(formeven.breve,'Description brève') }}
	      </div>
		  <div class="col-md-12">
			{{ form_errors(formeven.link) }}
			{{ form_widget(formeven.link) }}
			{{ form_label(formeven.link,'Ajouter un lien à l\'article') }}
		  </div>
	  </div>

	  <div class="row">
		<div class="file-field col-md-12">
			  <span>Image Article {{ form_errors(formeven.imgevenement) }}</span>
			  {{ form_widget(formeven.imgevenement) }}
		</div>

		<div class="col-md-12">
		<select id="typearticle" name="typearticle" class="browser-default form-control required" style="width: 100%; margin-top: 10px;">
			<option value="autres">Autres</option>
			<option value="facebook" {% if partie.typearticle == 'facebook' %}selected{% endif %}>Lien Facebook</option>
			<option value="likedin" {% if partie.typearticle == 'likedin' %}selected{% endif %}>Lien Linkedin</option>
			<option value="twitter" {% if partie.typearticle == 'twitter' %}selected{% endif %}>Lien Twitter</option>
			<option value="google" {% if partie.typearticle == 'google' %}selected{% endif %}>Lien google+</option>
			<option value="logo" {% if partie.typearticle == 'logo' %}selected{% endif %}>Logo de l'entreprise</option>
		</select>
		</div>

		<div class="col-md-12 mt-3">
		  <button class="btn btn-primary" type="submit" name="action">Enregister
			<i class="mdi-content-send right"></i>
		  </button>
		</div>
	  </div>

	 <div class="clear"></div>
   {{ form_end(formeven) }}
	<div class="clearfix"></div>
</div>
</div>

<script type="text/javascript" src="{{ asset('template/js/tiny.min.js') }}"></script>
<script type="text/javascript">
	tinymce.init({ selector:'.materialize-textarea', entity_encoding: "raw" });
</script>
