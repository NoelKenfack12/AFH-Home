{% extends "Theme/Users/Adminuser/layoutadmin.html.twig" %}

{% block meta %}
	{{ parent() }}
	<meta name="keywords" content="{{ site }}, Business, Innovation,Administration"/>
	<meta name="author" content="Noel Kenfack"/>
	<meta name="description" content="{{ site }} | Inscription | Cameroun " />
{% endblock %}

{% block title %}
	{{ parent() }} | {{ 'Accueil Admin'|trans }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}

    <style>
        .input-group {
        display: flex;
        align-content: stretch;
        }

        .input-group > input {
        flex: 1 0 auto;
        }

        /**
        * Even when I set some dimension-related styles on this
        * element but not on the input or button, they'll still
        * line up.
        */
        .input-group-addon {
        background: #eee;
        border: 1px solid #ccc;
        padding: 0.5em 1em;
        }
    </style>
{% endblock %}

{% block userblog_menuleft %}
	  {{ render(controller("App\\Controller\\Users\\Adminuser\\AccueilController:menuadmin")) }}
{% endblock %}

{% block userblog_body %}

{% include 'Theme/General/Template/Menu/descriptionvariable.html.twig' %}
<nav aria-label="breadcrumb">
	<ol class="breadcrumb bg-transparent mb-0 pb-0 pt-1 px-0 me-sm-6 me-5">
	  <li class="breadcrumb-item text-sm text-dark active"><a class="opacity-5 text-dark" href="#!">{{ 'Administration'|trans }}</a></li>
	</ol>
</nav>
<div class="divider mb-3" style="border-top: 2px dashed #999;"></div>

<div class="section" style="padding: 5px 0px 0px 0px;">
   
   
   <h5 id="galerie-reseller mt-3" style="border-bottom: 2px dashed #999; margin-bottom: 7px;">
    <a href="#!" class="open-modal-new-slide btn btn-primary" style="float: right;"><span class="mdi-av-playlist-add" style="font-size: 12px;"></span> Ajouter</a>
	   {{ 'Liste des questions'|trans }}:
   </h5>

   <div class="row mt-5">
	  <div class="col s12 m12 14">
	  <main style="box-shadow: 0px 0px 2px rgba(0,0,0,0.05); background: #fff;">
		{% for article in liste_article %}
		<div class="topic">
		  <div class="open">
			<h2 class="question"><img src="{{ asset('template/images/conversation.png') }}" alt="" style="width: 30px; height: 30px; margin-bottom: -8px!important;"/> {{ article.reference }} <span class="mdi-hardware-keyboard-arrow-right" style="font-size: 11px;"></span> {{ article.titre }}</h2>
			<span class="faq-t"></span>
		  </div>
		  <div class="answer">
			  <div class="module-comment-block">

				<div class="dropdown float-lg-end pe-4" style="float: right;">
					<a class="cursor-pointer" id="dropdownTable" data-bs-toggle="dropdown" aria-expanded="false">
					  <i class="fa fa-ellipsis-v text-secondary" aria-hidden="true"></i>
					</a>
					<ul class="dropdown-menu px-2 py-3 ms-sm-n4 ms-n5" aria-labelledby="dropdownTable">
	
						<li>
							<a href="#!" class="update-content-type-article dropdown-item" value="{{ article.id }}"><i class="mdi-editor-border-color"></i> Modifier</a>
						</li>
						<li>
							<a href="#!" class="add-content-new-candidat dropdown-item" value="{{ article.id }}"><i class="mdi-editor-border-color"></i> Ajouter Candidat</a>
						</li>
	
					</ul>
				</div>
				{% if article.firstPost|length  %}
				<div>
					<h3>{{ article.firstPost["proposition"] }}</h3>
					{% if article.firstPost["reponse"] == true %}
					<div><span class="label label-success">Bonne Réponse</span></div>
					{% else %}
					<div><span class="label label-danger">Mauvaise réponse</span></div>
					{% endif %}
				</div>
				{% endif %}
				{% if article.secondPost|length > 0 %}
				<div>
					<h3>{{ article.secondPost["proposition"] }}</h3>
					{% if article.secondPost["reponse"] == true %}
					<div><span class="label label-success">Bonne Réponse</span></div>
					{% else %}
					<div><span class="label label-danger">Mauvaise réponse</span></div>
					{% endif %}
				</div>
				{% endif %}
				{% if article.thirdPost|length  %}
				<div>
					<h3>{{ article.thirdPost["proposition"] }}</h3>
					{% if article.thirdPost["reponse"] == true %}
					<div><span class="label label-success">Bonne Réponse</span></div>
					{% else %}
					<div><span class="label label-danger">Mauvaise réponse</span></div>
					{% endif %}
				</div>
				{% endif %}


				<div class="table-responsive" style="width: 100%;">
                      <table class="table align-items-center" style="width: 100%;">
                        <thead>
                          <tr>
                            <th class="text-secondary text-sm font-weight-normal text-left p-2">Nom</th>
                            <th class="text-secondary text-sm font-weight-normal text-left p-2">Prenom</th>
                            <th class="text-secondary text-sm font-weight-normal text-left p-2">Téléphone</th>
                            <th class="text-secondary text-sm font-weight-normal text-left p-2">Email</th>
							<th class="text-secondary text-sm font-weight-normal text-left p-2">Ville</th>
							<th class="text-secondary text-sm font-weight-normal text-left p-2">Reponse</th>
                          </tr>
                        </thead>
                        <tbody>
							{% for candidat in article.candidats %}
                          <tr>
                            <td >
                              {{ candidat.nom }}
                            </td>
                            <td>
                              <h6 class="text-sm font-weight-normal mb-0">{{ candidat.prenom }}</h6>
                            </td>
                            <td>
                              <h6 class="text-sm font-weight-normal mb-0">{{ candidat.tel }}</h6>
                            </td>
                            <td class="align-middle text-sm">
                              <h6 class="text-sm font-weight-normal mb-0">{{ candidat.email }}</h6>
                            </td>
							<td class="align-middle text-sm">
                              <h6 class="text-sm font-weight-normal mb-0">{{ candidat.ville }}</h6>
                            </td>
							<td class="align-middle text-sm">
                              <h6 class="text-sm font-weight-normal mb-0">{{ candidat.reponse }}</h6>
                            </td>
                          </tr>
						  {% endfor %}

                        </tbody>
                      </table>
                    </div>

			  </div>
		  </div>
		</div>
		{% else %}
		<div class="topic">
		  <div class="open">
		  <h2 class="question">1. Aucun article publié pour cette catégorie
		  </h2><span class="faq-t"></span>
		  </div>
		  <p class="answer">La liste des articles des supports s'affichera ici.</p>
		</div>
		{% endfor %}
	  </main>
	  </div>
	  
	</div>

<!--DataTables example-->
</div>


<div class="modal fade" data-backdrop="false"  id="modalGestionCatalogueSelect" style="margin-top: 60px;">
<div class="modal-dialog">
<div class="modal-content" style="padding: 0px; border-radius: 0px;">

<div class="modal-header">
	<h5 class="modal-title"><i class="mdi-hardware-keyboard-alt"></i> Gestion du catalogue </h5>
	<button type="button" class="btn close" data-dismiss="modal" aria-label="Close" data-bs-dismiss="modal">
		<span aria-hidden="true">&times;</span>
	</button>
</div>

<div class="modal-body">
<div class="row">
	<div class="row">
		<div class="col-md-12">
		<div class="wait-chargement-content-module" style="text-align: center;">
			Patientez un moment pendant le chargement de l'article</br>
			<img src="{{ asset('template/images/loader1.gif') }}" alt="image" style="height: 40px; width: 40px;">
		</div>

		<div class="content-module-loading" style="display: none;">

		</div>
		</div>
	</div>
</div>
</div>
</div>
</div>
</div>

<div class="modal fade" data-backdrop="false" id="modalFormSlide" style="margin-top: 60px;">
<div class="modal-dialog">
<div class="modal-content" style="padding: 0px;">

	<div class="modal-header">
		<h5 class="modal-title"><i class="mdi-image-camera"></i> Ajouter une image</h5>
		<button type="button" class="btn close" data-dismiss="modal" aria-label="Close" data-bs-dismiss="modal">
		  <span aria-hidden="true">&times;</span>
		</button>
	</div>
	<div class="modal-body">
		<h4 class="header2">Préparer vos images pour les slides</h4>

		{{ form_start(form, {'attr': {'action': path('users_adminuser_liste_questionnaires') }}) }}
		<div class="form-group">
			<span style="color:red;">{{ form_errors(form) }}</span>
			<span style="color:red;">{{ form_errors(form.titre) }}</span>
			<div class="form-group">
				{{ form_widget(form.titre) }}
				{{ form_label(form.titre,'Titre du slide') }}
			</div>
		</div>

        <div class="input-group mb-3">
            <span class="input-group-addon">
                <input class="form-check-input" type="radio" name="reponse" id="flexRadioDefault1" value="first">
                <label class="form-check-label" for="flexRadioDefault1">
                    Bonne Réponse ?
                </label>
            </span>
            <input type="text" name="firstPost" placeholder="Proposition 1" required>
        </div>

        <div class="input-group mb-3">
            <span class="input-group-addon">
                <input class="form-check-input" type="radio" name="reponse" id="flexRadioDefault2" value="second">
                <label class="form-check-label" for="flexRadioDefault2">
                    Bonne Réponse ?
                </label>
            </span>
            <input type="text" name="secondPost" placeholder="Proposition 2" required/>
        </div>

        <div class="input-group mb-3">
            <span class="input-group-addon">
                <input class="form-check-input" type="radio" name="reponse" id="flexRadioDefault3" value="third">
                <label class="form-check-label" for="flexRadioDefault3">
                    Bonne Réponse ?
                </label>
            </span>
            <input type="text" name="thirdPost" placeholder="Proposition 3" required>
        </div>

        <div class="form-group mb-3">
			<span style="color:red;">{{ form_errors(form.nomGagnant) }}</span>
			<div class="form-group">
				{{ form_widget(form.nomGagnant) }}
				{{ form_label(form.nomGagnant,'Nom gagnant') }}
			</div>
		</div>

        <div class="form-group mb-3">
			<span style="color:red;">{{ form_errors(form.telGagnant) }}</span>
			<div class="form-group">
				{{ form_widget(form.telGagnant) }}
				{{ form_label(form.telGagnant,'Téléphone gagnant') }}
			</div>
		</div>

        <div class="form-group mb-3">
			<span style="color:red;">{{ form_errors(form.emailGagnant) }}</span>
			<div class="form-group">
				{{ form_widget(form.emailGagnant) }}
				{{ form_label(form.emailGagnant,'Téléphone gagnant') }}
			</div>
		</div>

        <div class="form-group mb-3">
			<span style="color:red;">{{ form_errors(form.villeGagnant) }}</span>
			<div class="form-group">
				{{ form_widget(form.villeGagnant) }}
				{{ form_label(form.villeGagnant,'Ville gagnant') }}
			</div>
		</div>

        <div class="form-group mb-3">
			<span style="color:red;">{{ form_errors(form.nomAuteur) }}</span>
			<div class="form-group">
				{{ form_widget(form.nomAuteur) }}
				{{ form_label(form.nomAuteur,'Ville gagnant') }}
			</div>
		</div>

        <div class="form-group mb-3">
			<span style="color:red;">{{ form_errors(form.telAuteur) }}</span>
			<div class="form-group">
				{{ form_widget(form.telAuteur) }}
				{{ form_label(form.telAuteur,'Ville gagnant') }}
			</div>
		</div>

		<div class="form-group mb-3">
			<span style="color:red;">{{ form_errors(form.consigne) }}</span>
			<div class="form-group">
				{{ form_widget(form.consigne) }}
				{{ form_label(form.consigne,'Consigne du gain') }}
			</div>
		</div>

		<div class="form-group">
			<button class="btn btn-primary float-end" type="submit" name="action">Enregister
				<i class="mdi-content-send right"></i>
			</button>
		</div>

		{{ form_end(form) }}

	</div>
	<div class="modal-footer" style="padding-top: 15px; z-index: 1;">
		{% include 'Theme/General/Template/Menu/social.html.twig' %}
	</div>
</div>
</div>
</div>

{% endblock %}


{% block srcjavascripttemplate %}

{% endblock %}

{% block javascripttemplate %}
$('.open-modal-new-slide').click(function(){
	$('#modalFormSlide').modal('show');
});

$('.update-content-type-article').click(function(){
	var id = $(this).attr('value');
	$('#modalGestionCatalogueSelect').modal('show');
	$('.wait-chargement-content-module').show();
	$('.content-module-loading').hide();
	$.get('{{ path('users_adminuser_set_gagnant_questionnaire') }}',{ id: id }, function(data){
		$('.wait-chargement-content-module').hide();
		$('.content-module-loading').show();
		$('.content-module-loading').html(data);
	});
});

$('.add-content-new-candidat').click(function(){
	var id = $(this).attr('value');
	$('#modalGestionCatalogueSelect').modal('show');
	$('.wait-chargement-content-module').show();
	$('.content-module-loading').hide();
	$.get('{{ path('users_adminuser_add_candidat_question') }}',{ id: id }, function(data){
		$('.wait-chargement-content-module').hide();
		$('.content-module-loading').show();
		$('.content-module-loading').html(data);
	});
});

$(".open").click(function(){
  var container = $(this).parents(".topic");
  var answer = container.find(".answer");
  var trigger = container.find(".faq-t");

  answer.slideToggle(200);

  if (trigger.hasClass("faq-o")) {
    trigger.removeClass("faq-o");
  }
  else {
    trigger.addClass("faq-o");
  }

  if (container.hasClass("expanded")) {
    container.removeClass("expanded");
  }
  else {
    container.addClass("expanded");
  }
});
{% endblock %}
