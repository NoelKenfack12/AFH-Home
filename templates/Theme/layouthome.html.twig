function openModalRight()
{
	if(animtail == 0)
	{
		$( "#top-sidebar-popper" ).animate({ "top": "+=100vh" }, "slow" );
		animtail = 100;
		$('#preloader-active').show("slow");
		$(".preloader2").css("background-color", "transparent");
	}else{
		$( "#top-sidebar-popper" ).animate({ "top": "-=100vh" }, "slow" );
		animtail = 0;
		$('#preloader-active').hide("slow");
		$(".preloader2").css("background-color", "#f7f7f7");
	}
}

function openCallBack(param)
{
	$.ajax({
       url : '{{ path('produit_service_callback_homepage') }}',
       type : 'POST',
       contentType: 'application/json',
       dataType: 'html',
       data : JSON.stringify( { "param": param } ),
       success : function(data, statut){
        //alert(data);
        openModalRight();

        setTimeout(function(){ 
          $('.content-article-tech').html(data);
          $('aside').toggleClass('open');
        }, 500);
			
       },

       error : function(resultat, statut, error){
         alertify.error("Le serveur a rencontré un problème lors du traitement de votre requête !");
		     openModalRight();
       }
    });
}

