  <script>

window.addEventListener('scroll', function() {
    var largeur = window.innerWidth;
    var dimension = 150;
    var header = document.getElementById('header-afh');

    if (window.scrollY > dimension) {
        header.classList.add('header-menu-hover-fixed');
        header.classList.remove('header-menu-hover');
    } else {
        header.classList.remove('header-menu-hover-fixed');
        header.classList.add('header-menu-hover');
    }
});

	// Toggle to show and hide navbar menu
const navbarMenu = document.getElementById("menu-afh");
const burgerMenu = document.getElementById("burger-afh");

burgerMenu.addEventListener("click", () => {
  navbarMenu.classList.toggle("is-active-menu-hover");
  burgerMenu.classList.toggle("is-active-menu-hover");
});

// Toggle to show and hide dropdown menu
const dropdown = document.querySelectorAll(".dropdown-menu-hover");

dropdown.forEach((item) => {
  const dropdownToggle = item.querySelector(".dropdown-toggle-menu-hover");

  dropdownToggle.addEventListener("click", () => {
    const dropdownShow = document.querySelector(".dropdown-show-menu-hover");
    toggleDropdownItem(item);

    // Remove 'dropdown-show' class from other dropdown
    if (dropdownShow && dropdownShow != item) {
      toggleDropdownItem(dropdownShow);
    }
  });
});

// Function to display the dropdown menu
const toggleDropdownItem = (item) => {
  const dropdownContent = item.querySelector(".dropdown-content-menu-hover");

  // Remove other dropdown that have 'dropdown-show' class
  if (item.classList.contains("dropdown-show-menu-hover")) {
    dropdownContent.removeAttribute("style");
    item.classList.remove("dropdown-show-menu-hover");
  } else {
    // Added max-height on active 'dropdown-show' class
    dropdownContent.style.height = dropdownContent.scrollHeight + "px";
    item.classList.add("dropdown-show-menu-hover");
  }
};

// Fixed dropdown menu on window resizing
window.addEventListener("resize", () => {
  if (window.innerWidth > 992) {
    document.querySelectorAll(".dropdown-content-menu-hover").forEach((item) => {
      item.removeAttribute("style");
    });
    dropdown.forEach((item) => {
      item.classList.remove("dropdown-show-menu-hover");
    });
  }
});

// Fixed navbar menu on window resizing
window.addEventListener("resize", () => {
  if (window.innerWidth > 992) {
    if (navbarMenu.classList.contains("is-active-menu-hover")) {
      navbarMenu.classList.remove("is-active-menu-hover");
      burgerMenu.classList.remove("is-active-menu-hover");
    }
  }
});

  </script>
